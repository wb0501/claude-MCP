# Copy to .mcp_env and fill in locally. Never commit .mcp_env.
# Notion source/eval pages
SOURCE_NOTION_API_KEY=
EVAL_NOTION_API_KEY=
SOURCE_PARENT_PAGE_TITLE=
EVAL_PARENT_PAGE_TITLE=

# Playwright
PLAYWRIGHT_BROWSER=
PLAYWRIGHT_HEADLESS=

# GitHub evaluation org
GITHUB_TOKENS=
GITHUB_EVAL_ORG=

# Postgres
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Optional model relay used by the local Claude CLI
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
